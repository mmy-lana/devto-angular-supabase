# Copy this file to `.env` and fill in the values below.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Both values live in Supabase → Project Settings → API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Public "anon" key. Safe to ship: every table is protected by the row level
# security policies applied by the migration in plan.md.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
